<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="250dp"
    android:layout_height="350dp"
    android:orientation="vertical"
    android:background="@drawable/bg_stamp_border"
    android:layout_marginEnd="48dp"
    android:elevation="4dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/imgStamp"
        android:layout_width="196dp"
        android:layout_height="260dp"
        android:layout_marginTop="28dp"
        android:contentDescription="@string/todo"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvYear"
        android:layout_width="200dp"
        android:layout_height="35dp"
        android:background="#903434"
        android:gravity="center"
        android:text="@string/topic"
        android:textColor="#000"
        android:textSize="20sp"
        android:textStyle="italic|bold"
        app:layout_constraintEnd_toEndOf="@+id/imgStamp"
        app:layout_constraintStart_toStartOf="@+id/imgStamp"
        app:layout_constraintTop_toBottomOf="@+id/imgStamp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
